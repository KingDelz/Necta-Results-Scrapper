}
first_table <- html_table(tables[[1]], fill = TRUE)
first_table[] <- lapply(first_table, as.character)
table <- first_table |>
select(-X1) |>
slice(1, 4) |>
rename(I = X2, II = X3, III = X4, IV = X5, "0" = X6) |>
slice(-1) |>
pivot_longer(everything(), names_to = "Division", values_to = "Count") |>
mutate(
necta_exam_centre_no = school,
Year = year
)
all_tables[[paste(school, year, sep = "_")]] <- table
}

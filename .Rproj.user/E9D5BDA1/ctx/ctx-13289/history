library(rvest)
library(tidyverse)
library(readxl)
library(writexl)
# --------------------------
# Load school list
# --------------------------
source <- read_excel("Data/source.xlsx", sheet = "Primary") %>%
filter(necta_centre_no != "Missing")
schoollist <- tolower(source$necta_centre_no)
# --------------------------
# Parameters
# --------------------------
year <- 2022
url_base <- "https://onlinesys.necta.go.tz/results/"
# Create folders if they don't exist
if (!dir.exists("Outputs")) dir.create("Outputs")
# Create folders if they don't exist
# if (!dir.exists("Outputs")) dir.create("Outputs")
checkpoint_file <- "Outputs/primary_progress.rds"
# If checkpoint exists, load progress
if (file.exists(checkpoint_file)) {
message("Resuming from previous checkpoint...")
progress <- readRDS(checkpoint_file)
all_tables <- progress$all_tables
failed_schools <- progress$failed_schools
processed <- names(all_tables)
} else {
all_tables <- list()
failed_schools <- c()
processed <- c()
}
# --------------------------
# Scraper function
# --------------------------
scrape_school <- function(school, year) {
sch_url <- paste0(url_base, year, "/psle/results/shl_", school, ".htm")
webpage <- tryCatch(
read_html(sch_url),
error = function(e) {
message("Could not open: ", sch_url)
failed_schools <<- c(failed_schools, paste(school, year, sep = "_"))
return(NULL)
}
)
if (is.null(webpage)) return(NULL)
tables <- html_nodes(webpage, "table")
if (length(tables) == 0) {
message("No table found for ", school, " in ", year)
failed_schools <<- c(failed_schools, paste(school, year, sep = "_"))
return(NULL)
}
first_table <- html_table(tables[[1]], fill = TRUE)
first_table[] <- lapply(first_table, as.character)
table <- first_table %>%
select(-X1) %>%
slice(1, 4) %>%
rename(A = X2, B = X3, C = X4, D = X5, E = X6) %>%
slice(-1) %>%
pivot_longer(everything(), names_to = "Grade", values_to = "Count") %>%
mutate(necta_centre_no = school, Year = year)
return(table)
}
# --------------------------
# Main loop with checkpoints
# --------------------------
counter <- 0
for (school in schoollist) {
key <- paste(school, year, sep = "_")
if (key %in% processed) {
next  # skip already processed schools
}
result <- scrape_school(school, year)
if (!is.null(result)) {
all_tables[[key]] <- result
}
counter <- counter + 1
# Save progress every 500 schools
if (counter %% 500 == 0) {
saveRDS(list(all_tables = all_tables, failed_schools = failed_schools),
checkpoint_file)
message("Checkpoint saved after ", counter, " schools.")
}
# Small random delay (avoid blocking)
Sys.sleep(runif(1, 0.3, 1.2))
}
# --------------------------
# Final output
# --------------------------
final_df <- bind_rows(all_tables) %>%
relocate(c(necta_centre_no, Year), .before = Grade)
write_xlsx(final_df, "Outputs/Primary.xlsx")
if (length(failed_schools) > 0) {
message("\nThese school-year pages could not be processed:")
print(failed_schools)
}
View(final_df)
